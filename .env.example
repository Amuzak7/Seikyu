# ─────────────────────────────────────────────────────────────
# Seikyu 環境変数サンプル
# このファイルをコピーして .env にリネームし、実際の値を入力してください。
#   cp .env.example .env
#
# .env は .gitignore で除外されており、Git にはコミットされません。
# .env.example はダミー値のままコミットして共有してください。
# ─────────────────────────────────────────────────────────────

# ── 動作モード ─────────────────────────────────────────────────
# true  : デモモード（起動時にDBリセット・データは再起動で消える）
# false : 本番モード（データを永続化）
DEMO_MODE=false

# ── データベース ───────────────────────────────────────────────
# DEMO_MODE=false のときのみ有効。
# デフォルト: seikyu.db（プロジェクトルートに作成）
DB_PATH=seikyu.db

# ── アプリ設定 ─────────────────────────────────────────────────
APP_TITLE=Seikyu
APP_VERSION=1.0.0
